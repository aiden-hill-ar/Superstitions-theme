	"tokenColors": [
		{
			"name": "Orange",
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag",
				"storage.type",
				"punctuation.definition.heading.markdown",
				"punctuation.definition.list.begin.markdown",
				"meta.separator.markdown"
			],
			"settings": {
				"foreground": "#f2855f"
			}
		},

		{
			"name": "Dark Blue",
			"scope": [
				"entity.other.attribute-name",
				"support.type.property-name",
				"variable.other.readwrite",
				"variable.other.constant",
				"markup.underline.link.markdown"
			],
			"settings": {
				"foreground": "#5fa0e2"
			}
		},
		{
			"name": "Light Blue",
			"scope": [
				"string",
				"string.regexp keyword.operator",
				"string.regexp keyword.control",
				"markup.inline.raw.string.markdown"
			],
			"settings": {
				"foreground": "#9fc4ec"
			}
		},

		{
			"name": "Purple",
			"scope": [
				"entity.other.attribute-name.pseudo-class",
				"entity.other.attribute-name.pseudo-element",
				"entity.other.attribute-name.id",
				"variable.other.property",
				"variable.other.object.property"
			],
			"settings": {
				"foreground": "#a18ff7"
			}
		},

		{
			"name": "Yellow",
			"scope": [
				"keyword.operator",
				"keyword.control",
				"entity.other.attribute-name.class"
			],
			"settings": {
				"foreground": "#e1bb55"
			}
		},
		{
			"name": "Tan",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#ecc89e"
			}
		},
		{
			"name": "White-Tan",
			"scope": [
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#daae7a"
			}
		},

		{
			"name": "Green",
			"scope": [
				"variable.language",
				"constant.language"
			],
			"settings": {
				"foreground": "#63bf69"
			}
		},
		{
			"name": "Light Green",
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#7ad27e"
			}
		},

		{
			"name": "Muted",
			"scope": [
				"punctuation.separator",
				"punctuation.terminator",
				"comment"
			],
			"settings": {
				"foreground": "#8594c5"
			}
		},
		{
			"name": "Bold",
			"scope": [
				"comment",
				"markup.bold.markdown"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Italic",
			"scope": [
				"markup.italic.markdown"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"name": "Italic Bold",
			"scope": [
				"markup.bold.markdown markup.italic.markdown"
			],
			"settings": {
				"fontStyle": "italic bold"
			}
		}
	]
}
	"tokenColors": [
		{
			"name": "Orange",
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag",
				"storage.type"
			],
			"settings": {
				"foreground": "#af5839"
			}
		},
		
		{
			"name": "Blue",
			"scope": [
				"entity.other.attribute-name",
				"support.type.property-name",
				"variable.other.readwrite",
				"variable.other.constant"
			],
			"settings": {
				"foreground": "#3e78b1"
			}
		},
		{
			"name": "Dark Blue",
			"scope": [
				"string",
				"string.regexp keyword.operator",
				"string.regexp keyword.control"
			],
			"settings": {
				"foreground": "#305982"
			}
		},

		{
			"name": "Purple",
			"scope": [
				"entity.other.attribute-name.pseudo-class",
				"entity.other.attribute-name.pseudo-element",
				"entity.other.attribute-name.id",
				"variable.other.property",
				"variable.other.object.property"
			],
			"settings": {
				"foreground": "#7561c4"
			}
		},

		{
			"name": "Yellow",
			"scope": [
				"keyword.operator",
				"keyword.control",
				"entity.other.attribute-name.class"
			],
			"settings": {
				"foreground": "#8e7016"
			}
		},
		{
			"name": "Tan",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#8e6e46"
			}
		},
		{
			"name": "Dark-Tan",
			"scope": [
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#513717"
			}
		},

		{
			"name": "Green",
			"scope": [
				"variable.language",
				"constant.language"
			],
			"settings": {
				"foreground": "#2b8a36"
			}
		},
		{
			"name": "Light Green",
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#0d4a16"
			}
		},

		{
			"name": "Muted",
			"scope": [
				"punctuation.separator",
				"punctuation.terminator",
				"comment"
			],
			"settings": {
				"foreground": "#8c9aa9"
			}
		},
		{
			"name": "Bold",
			"scope": [
				"comment"
			],
			"settings": {
				"fontStyle": "bold"
			}
		}
	]
}